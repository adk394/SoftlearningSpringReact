{
  "info": {
    "_postman_id": "softlearning-jwt-collection",
    "name": "Softlearning JWT API",
    "description": "Colección para probar la API de Softlearning con autenticación JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"1234\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "auth", "login"]
            },
            "description": "Iniciar sesión como administrador"
          }
        },
        {
          "name": "Login - Manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manager\",\n  \"password\": \"1234\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "auth", "login"]
            },
            "description": "Iniciar sesión como manager"
          }
        },
        {
          "name": "Login - User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"1234\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "auth", "login"]
            },
            "description": "Iniciar sesión como usuario estándar"
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"password123\",\n  \"roles\": [\"USER\"]\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "auth", "register"]
            },
            "description": "Registrar un nuevo usuario con rol USER"
          }
        }
      ]
    },
    {
      "name": "02 - Books (USER puede GET)",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8082/api/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "books"]
            },
            "description": "Obtener todos los libros - Requiere autenticación"
          }
        }
      ]
    },
    {
      "name": "03 - Books (MANAGER puede POST/PUT)",
      "item": [
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 0,\n  \"title\": \"Nuevo Libro JWT\",\n  \"price\": 29.99,\n  \"description\": \"Libro creado con autenticación JWT\",\n  \"isbn\": \"ISBN-99999\",\n  \"publicationDate\": \"2024-01-01\",\n  \"editorial\": \"Editorial Test\",\n  \"pages\": 300,\n  \"weight\": 0.5,\n  \"height\": 0.3,\n  \"width\": 0.2\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/books",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "books"]
            },
            "description": "Crear un nuevo libro - Requiere rol MANAGER o ADMIN"
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"Libro Actualizado JWT\",\n  \"price\": 39.99,\n  \"description\": \"Libro actualizado con autenticación JWT\",\n  \"isbn\": \"ISBN-UPDATED\",\n  \"publicationDate\": \"2024-01-01\",\n  \"editorial\": \"Editorial Test\",\n  \"pages\": 350,\n  \"weight\": 0.6,\n  \"height\": 0.3,\n  \"width\": 0.2\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/books/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "books", "1"]
            },
            "description": "Actualizar un libro - Requiere rol MANAGER o ADMIN"
          }
        }
      ]
    },
