{
  "info": {
    "name": "Softlearning API - Pruebas de Permisos",
    "description": "Colección completa para probar los permisos de cada rol (USER, MANAGER, ADMIN)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 01 - AUTH",
      "item": [
        {
          "name": "Login - ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Guardar el token",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"token\", jsonData.token);",
                  "",
                  "// Tests",
                  "pm.test(\"Login ADMIN - Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Token recibido\", function () {",
                  "    pm.expect(jsonData.token).to.exist;",
                  "    pm.expect(jsonData.token).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"Roles correctos\", function () {",
                  "    pm.expect(jsonData.roles).to.include(\"ADMIN\");",
                  "});",
                  "",
                  "console.log(\"✅ ADMIN logueado. Roles:\", jsonData.roles.join(\", \"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
